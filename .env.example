# ==============================================================
# cateim/cups
# Copy to .env and fill in. Never commit the .env.
# ==============================================================

# ---- Secrets (required, no default) ----
ADMIN_PASSWORD=                        # password for the CUPS 'admin' user, set by docker-entrypoint.sh

# ---- Runtime ----
TZ=America/Sao_Paulo                   # container timezone, used by the CUPS logs
